# ==============================================================================
#                      BLOG EXPERT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` and replace the placeholder values with your actual API keys.
# All links and step-by-step instructions on how to acquire each key are provided below.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. PRIMARY LLM PROVIDERS (Online Cloud Models)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# OpenAI API Key
# Portal: https://platform.openai.com/api-keys
# Details:
# 1. Log in or create an OpenAI developer account.
# 2. Go to Dashboard -> API Keys -> "Create new secret key".
# 3. Requires prepaid billing credits for GPT-4o / GPT-4.1 models.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=<your_openai_api_key>

# ------------------------------------------------------------------------------
# Groq API Key (Ultra-fast Cloud Inference - Free Tier Available)
# Portal: https://console.groq.com/keys
# Details:
# 1. Sign up for a free Groq Cloud account.
# 2. Navigate to "API Keys" and click "Create API Key".
# 3. Used for rapid Llama-3.3 and Llama-3.1 specialist reviews & aggregation.
# ------------------------------------------------------------------------------
GROQ_API_KEY=<your_groq_api_key>

# ------------------------------------------------------------------------------
# Google Gemini API Key (High Token Limits - Free Tier Available)
# Portal: https://aistudio.google.com/app/apikey
# Details:
# 1. Open Google AI Studio with your Google Account.
# 2. Click "Create API Key" (choose/create a Google Cloud project).
# 3. Used for Gemini Flash multi-stage writing, reasoning, and embeddings.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=<your_gemini_api_key>


# ------------------------------------------------------------------------------
# 2. VECTOR DATABASE & KNOWLEDGE RETRIEVAL (RAG)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Pinecone API Key (Serverless Vector Database - Free Tier Available)
# Portal: https://app.pinecone.io/
# Details:
# 1. Create a free account on Pinecone.
# 2. In the dashboard, click "API Keys" to copy your default key or create one.
# 3. Supports serverless vector search for blog chunk indexing & retrieval.
# ------------------------------------------------------------------------------
PINECONE_API_KEY=<your_pinecone_api_key>
PINECONE_INDEX_NAME=blog-enhancer


# ------------------------------------------------------------------------------
# 3. WEB RESEARCH & SCRAPING AGENTS
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Tavily Search API Key (AI-Native Live Web & Fact Research)
# Portal: https://app.tavily.com/
# Details:
# 1. Register for a free Tavily account (includes 1,000 free searches/month).
# 2. Copy the API key from your Tavily dashboard.
# 3. Powers live web research, latest facts verification, and image discovery.
# ------------------------------------------------------------------------------
TAVILY_API_KEY=<your_tavily_api_key>

# ------------------------------------------------------------------------------
# Firecrawl API Key (Web Scraping & Clean Markdown Extraction)
# Portal: https://www.firecrawl.dev/
# Details:
# 1. Sign up at Firecrawl.dev (free tier provides 500 scraped pages).
# 2. Generate and copy your API key from the dashboard.
# 3. Used for scraping source URLs, deep crawling, and extracting structured markdown.
# ------------------------------------------------------------------------------
FIRECRAWL_API_KEY=<your_firecrawl_api_key>


# ------------------------------------------------------------------------------
# 4. VISION / MULTI-MODAL & OPENROUTER (Nemotron)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# OpenRouter / Nemotron API Key (Vision & Multi-modal Image Ranking)
# Portal: https://openrouter.ai/keys
# Details:
# 1. Create an account on OpenRouter.ai.
# 2. Go to "Keys" and generate a new API key.
# 3. Supports open weights models including free Nemotron endpoints.
# ------------------------------------------------------------------------------
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NEMOTRON_API_KEY=<your_nemotron_openrouter_api_key>


# ------------------------------------------------------------------------------
# 5. HUGGING FACE TOKEN (Optional Embeddings / Open Models)
# Portal: https://huggingface.co/settings/tokens
# Details:
# 1. Create an account on Hugging Face.
# 2. Go to Settings -> Access Tokens -> "Create New Token" (Type: Read).
# ------------------------------------------------------------------------------
HUGGINGFACEHUB_API_TOKEN=<your_huggingface_api_token>


# ------------------------------------------------------------------------------
# 6. MODEL NAMES & PIPELINE HYPERPARAMETERS
# ------------------------------------------------------------------------------
OPENAI_MODEL=gpt-4.1
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=3072
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Chunking & Retrieval Parameters
CHUNK_SIZE=1200
CHUNK_OVERLAP=250
TOP_K=8
